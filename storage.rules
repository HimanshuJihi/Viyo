rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Legacy videos were uploaded as user_videos/{uid}_{timestamp}_{fileName}.
    // Keep them readable so existing long videos and Flicks continue to play.
    match /user_videos/{legacyFileName} {
      allow read: if true;
      allow write: if false;
    }

    match /user_videos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /user_images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /user_thumbnails/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /user_promotions/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /stories/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Keep existing flat story files readable during migration.
    match /stories/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /chat_media/{conversationId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
