rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow reads publicly (adjust as you need);
      allow read: if true;

      // Allow authenticated writes only if within plan limit.
      // The rules read /config/plan Firestore document to decide.
      allow write: if request.auth != null && isWithinPlanLimit();
    }
  }

  // Helper: returns true if the upload size is allowed for the current plan.
  function isWithinPlanLimit() {
    // Try to read plan document from Firestore
    let planDoc = get(/databases/(default)/documents/config/plan);
    // If plan is blaze, allow any size. Otherwise enforce 1 MB limit.
    return planDoc.exists && planDoc.data.plan == 'blaze' ? true : request.resource.size <= 1048576;
  }
}
