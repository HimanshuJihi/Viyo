rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Legacy videos were uploaded as user_videos/{uid}_{timestamp}_{fileName}.
    // Keep them readable so existing long videos and Flicks continue to play.
    match /user_videos/{legacyFileName} {
      allow read: if true;
      allow write: if false;
    }

    match /user_videos/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /user_promotions/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /stories/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /chat_media/{conversationId}/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Allow anyone (even logged out) to read public content
    match /blogs/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /stories/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /users/{userId} {
      allow read: if true;
      // Users can only edit their own profile, except for admins
      allow write: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }
    
    match /settings/{document} {
      allow read: if true;
      // Only admins can change settings
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // 2. Allow authenticated users to chat with each other
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // 3. For all other collections (notifications, withdrawals, reports, etc.)
    // Require the user to be logged in
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
